<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat Definition -->
    <record id="paperformat_Departure_Custom" model="report.paperformat">
        <field name="name">Departure - Custom</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Action Report -->
    <record id="action_report_departure_ams" model="ir.actions.report">
        <field name="name">Departure Clearance</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sijil_hr_employee_departure.report_departure_ams</field>
        <field name="report_file">sijil_hr_employee_departure.report_departure_ams</field>
        <field name="print_report_name">'Departure - %s' % (object.name)</field>
        <field name="paperformat_id" ref="sijil_hr_employee_departure.paperformat_Departure_Custom"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_departure_ams">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Dynamic values and safe fallbacks -->
                <t t-set="contract" t-value="o['contract_id'] if 'contract_id' in o._fields else False"/>
                <t t-set="departure_date" t-value="(o['departure_date'] if 'departure_date' in o._fields else False) or (o['departure_date_from'] if 'departure_date_from' in o._fields else False)"/>
                <t t-set="departure_reason_record" t-value="o['departure_reason_id'] if 'departure_reason_id' in o._fields else False"/>
                <t t-set="employee_number" t-value="(o['barcode'] if 'barcode' in o._fields else False) or ''"/>
                <t t-set="bank_account" t-value="(o['bank_account_ids'] if 'bank_account_ids' in o._fields else False)"/>
                <t t-set="company_signatory_name" t-value="o.parent_id.name if o.parent_id else ''"/>
                <t t-set="company_signatory_title" t-value="o.parent_id.job_title if o.parent_id else ''"/>
                <t t-set="accrued_amount" t-value="o.employee_accrued or 0.0"/>

                <style>
                    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&amp;display=swap');

                    body {
                        font-family: 'Cairo', 'Segoe UI', Arial, sans-serif;
                        color: #1e293b;
                        background-color: #ffffff;
                    }

                    .departure-page {
                        position: relative;
                        direction: rtl;
                        text-align: right;
                        font-size: 15px;
                        line-height: 1.6;
                        padding: 0;
                    }

                    .departure-page.page-two {
                        page-break-before: always;
                    }

                    /* Header Styles */
                    .header-table {
                        width: 100%;
                        margin-bottom: 12px;
                        border-bottom: 2px solid #f3e8ff;
                        padding-bottom: 10px;
                    }

                    .company-logo {
                        max-width: 140px;
                        max-height: 70px;
                        object-fit: contain;
                    }

                    .doc-main-title {
                        text-align: center;
                        background: #5b21b6;
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 700;
                        padding: 8px 15px;
                        border-radius: 6px;
                        margin-bottom: 16px;
                        letter-spacing: 0.5px;
                    }

                    /* Section Header */
                    .section-bar {
                        background: #f5f3ff;
                        color: #3b0764;
                        font-size: 16px;
                        font-weight: 700;
                        padding: 6px 12px;
                        margin: 14px 0 10px 0;
                        border-right: 4px solid #7e22ce;
                        border-radius: 0 4px 4px 0;
                    }

                    /* Info Grid Table */
                    .info-grid-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 15px;
                    }

                    .info-grid-table td {
                        padding: 6px 10px;
                        border: 1px solid #e9d5ff;
                        font-size: 14px;
                        vertical-align: middle;
                    }

                    .info-grid-table .lbl {
                        background-color: #f5f3ff;
                        font-weight: 600;
                        color: #4c1d95;
                        width: 18%;
                    }

                    .info-grid-table .val {
                        color: #0f172a;
                        width: 32%;
                    }

                    .info-grid-table .val-full {
                        color: #0f172a;
                        width: 82%;
                    }

                    /* Paragraphs &amp; Lists */
                    .contract-section {
                        margin-bottom: 10px;
                    }

                    .contract-section p {
                        margin: 0 0 8px;
                        text-align: justify;
                        color: #334155;
                    }

                    .benefits-list,
                    .general-list {
                        margin: 6px 0 12px 0;
                        padding-right: 22px;
                        color: #334155;
                    }

                    .benefits-list li,
                    .general-list li {
                        margin-bottom: 6px;
                    }

                    /* Financial Box */
                    .amount-box {
                        background-color: #faf5ff;
                        border: 1px dashed #c084fc;
                        border-radius: 6px;
                        padding: 10px 14px;
                        margin: 10px 0;
                    }

                    .amount-line {
                        margin: 3px 0 !important;
                        font-size: 15px;
                    }

                    .amount-line strong {
                        color: #6b21a8;
                    }

                    /* Signatures Section */
                    .signature-block {
                        margin-top: 25px;
                    }

                    .signature-table {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 12px 0;
                    }

                    .signature-cell {
                        width: 50%;
                        vertical-align: top;
                        background: #ffffff;
                        border: 1px solid #d8b4fe;
                        border-radius: 6px;
                        padding: 12px;
                    }

                    .signature-title {
                        font-weight: 700;
                        color: #4c1d95;
                        font-size: 15px;
                        border-bottom: 1px solid #f3e8ff;
                        padding-bottom: 6px;
                        margin-bottom: 8px;
                        text-align: center;
                    }

                    .signature-content {
                        font-size: 14px;
                        line-height: 1.8;
                    }

                    .acknowledgement {
                        font-size: 13px;
                        color: #475569;
                        margin-bottom: 10px;
                        text-align: justify;
                    }

                    .dots-line {
                        color: #a855f7;
                    }
                </style>

                <!-- PAGE 1 -->
                <div class="departure-page">
                    <!-- Top Bar Header -->
                    <table class="header-table">
                        <tr>
                            <td style="text-align: right; vertical-align: middle;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="company-logo" alt="Company Logo"/>
                            </td>
                            <td style="text-align: left; vertical-align: middle; color: #64748b; font-size: 13px;">
                                <div><span t-field="o.company_id.name"/></div>
                                <div>التاريخ:
                                    <strong t-if="departure_date" t-out="departure_date.strftime('%d/%m/%Y')"/>
                                    <strong t-else="" t-out="time.strftime('%d/%m/%Y')"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div class="doc-main-title">اتفاق إنهاء علاقة عمل ومخالصة نهائية</div>

                    <!-- Grid Info Table -->
                    <table class="info-grid-table">
                        <tr>
                            <td class="lbl">الطرف الأول:</td>
                            <td class="val" colspan="3">
                                <strong>شركة <span t-field="o.company_id.name" style="unicode-bidi: bidi-override; direction: ltr;"/></strong>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">الطرف الثاني (الموظف):</td>
                            <td class="val"><strong><span t-field="o.name"/></strong></td>
                            <td class="lbl">الرقم الوظيفي:</td>
                            <td class="val"><span t-out="employee_number"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">رقم الهوية:</td>
                            <td class="val"><span t-out="o.identification_id or ''"/></td>
                            <td class="lbl">رقم العقد:</td>
                            <td class="val"><span t-out="o.contract_number or ''"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">سبب إنهاء العقد:</td>
                            <td class="val-full" colspan="3">
                                <span t-if="departure_reason_record" t-field="departure_reason_record.name"/>
                                <span t-elif="'departure_reason' in o._fields and o['departure_reason']" t-out="o['departure_reason']"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Section 1 -->
                    <div class="contract-section">
                        <div class="section-bar">أولاً: إنهاء علاقة العمل</div>
                        <p>
                            تقرر إنهاء علاقة العمل بين الطرفين استنادًا إلى أحكام نظام العمل السعودي وعقد العمل المبرم بين الطرفين،
                            وبناءً على سبب الإنهاء الموضح أعلاه، ويُعد يوم
                            <strong><span t-if="departure_date" t-out="('الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت', 'الأحد')[departure_date.weekday()]"/></strong>
                            الموافق
                            <strong><span t-if="departure_date" t-out="departure_date.strftime('%d/%m/%Y')"/></strong>
                            هو آخر يوم عمل للموظف لدى الشركة.
                        </p>
                        <p>ويُقر الطرفان بأن هذا الإنهاء تم وفقًا للأحكام النظامية ذات العلاقة.</p>
                    </div>

                    <!-- Section 2 -->
                    <div class="contract-section">
                        <div class="section-bar">ثانيًا: تصفية المستحقات المالية</div>
                        <p>يقر الطرفان بأنه تم تصفية جميع المستحقات المالية النظامية للموظف حتى تاريخ انتهاء علاقة العمل، وتشمل:</p>
                        <ul class="benefits-list">
                            <li>الرواتب المستحقة حتى آخر يوم عمل</li>
                            <li>بدل الإجازات المستحقة غير المستخدمة (إن وجدت)</li>
                            <li>أي مستحقات مالية نظامية أخرى مستحقة حتى تاريخ الإنهاء</li>
                        </ul>

                        <p>وقد بلغ إجمالي المستحقات المالية المستحقة للموظف مبلغًا وقدره:</p>

                        <!-- Highlighted Amount Box -->
                        <div class="amount-box">
                            <p class="amount-line">
                                <strong>رقمًا:</strong>
                                <span t-field="o.employee_accrued" t-options='{"widget": "float", "precision": 2}'/>
                                ريال سعودي
                            </p>
                            <p class="amount-line">
                                <strong>كتابةً:</strong>
                                <span t-out="o.company_id.currency_id.with_context(lang='ar_001').amount_to_text(accrued_amount)"/>
                                لا غير
                            </p>
                        </div>

                        <p style="margin-top: 10px;">
                            وقد تم تحويل مبلغ المستحقات ( ان وجدت ) إلى الحساب البنكي الخاص بالموظف رقم
                            ( <strong><span t-out="bank_account.acc_number if bank_account else ''"/></strong> )
                            والمسجل لدى الشركة، ويقر الطرف الثاني باستلامه كاملًا دون أي نقص
                        </p>
                    </div>
                </div>

                <!-- PAGE 2 -->
                <div class="departure-page page-two">
                    <!-- Header -->
                    <table class="header-table">
                        <tr>
                            <td style="text-align: right; vertical-align: middle;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="company-logo" alt="Company Logo"/>
                            </td>
                            <td style="text-align: left; vertical-align: middle; color: #64748b; font-size: 13px;">
                            </td>
                        </tr>
                    </table>

                    <!-- Section 3 -->
                    <div class="contract-section">
                        <div class="section-bar">ثالثًا: الإقرار والمخالصة</div>
                        <p>
                            يقر الطرف الثاني بأنه استلم كامل مستحقاته المالية والنظامية المترتبة على علاقة العمل حتى تاريخ انتهائها،
                            وأنه لا توجد له أي مطالبات مالية أو تعاقدية ناشئة عن فترة عمله لدى الشركة حتى تاريخ الإنهاء،
                            ويُعد هذا الإقرار مخالصة نهائية وإبراءً لذمة الشركة في حدود الحقوق التي تمت تسويتها بموجب هذا الاتفاق،
                            وذلك دون الإخلال بأي حقوق لا يجوز التنازل عنها نظامًا.
                        </p>
                    </div>

                    <!-- Section 4 -->
                    <div class="contract-section">
                        <div class="section-bar">رابعًا: أحكام عامة</div>
                        <ul class="general-list">
                            <li>يقر الطرفان بأن هذا الاتفاق قد تم بكامل إرادتهما ودون إكراه، وبعد الاطلاع على مضمونه وفهم جميع أحكامه، ويُعد ملزمًا للطرفين من تاريخ توقيعه.</li>
                            <li>لا يخل هذا الاتفاق بأي حقوق نظامية لا يجوز التنازل عنها بموجب نظام العمل.</li>
                            <li>حرر هذا الاتفاق من نسختين أصليتين، استلم كل طرف نسخة للعمل بموجبها.</li>
                        </ul>
                    </div>

                    <!-- Signatures Block -->
                    <div class="signature-block">
                        <table class="signature-table">
                            <tr>
                                <!-- الشركة -->
                                <td class="signature-cell">
                                    <div class="signature-title">توقيع الطرف الأول (الشركة)</div>
                                    <div class="signature-content">
                                        <div><strong>الاسم:</strong> <span t-out="company_signatory_name"/></div>
                                        <div><strong>الصفة:</strong> <span t-out="company_signatory_title"/></div>
                                        <div style="margin-top: 15px;"><strong>التوقيع والختم:</strong></div>
                                        <div class="dots-line" style="margin-top: 25px;">............................................................</div>
                                    </div>
                                </td>

                                <!-- الموظف -->
                                <td class="signature-cell">
                                    <div class="signature-title">توقيع الطرف الثاني (الموظف/ هـ)</div>
                                    <div class="signature-content">
                                        <p class="acknowledgement">أقر باستلامي كامل مستحقاتي النظامية وموافقتي على ما ورد في هذا الاتفاق.</p>
                                        <div><strong>الاسم:</strong> <span t-field="o.name"/></div>
                                        <div><strong>التاريخ:</strong>
                                            <span t-if="departure_date" t-out="departure_date.strftime('%d/%m/%Y')"/>
                                            <span t-else="" t-out="time.strftime('%d/%m/%Y')"/>
                                        </div>
                                        <div style="margin-top: 10px;"><strong>التوقيع:</strong></div>
                                        <div class="dots-line" style="margin-top: 25px;">............................................................</div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>